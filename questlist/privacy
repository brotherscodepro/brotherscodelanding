    var STORAGE_KEY = "questlist_privacy_lang";
    var btnEn = document.getElementById('btn-en');
    var btnPt = document.getElementById('btn-pt');
    var copyBtn = document.getElementById('copy-email');
    var nodes = document.querySelectorAll('[data-i18n]');

    function getSavedLang() {
      try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
    }
    function saveLang(lang) {
      try { localStorage.setItem(STORAGE_KEY, lang); } catch (e) {}
    }

    function applyLang(lang) {
      var dict = DICT[lang] || DICT.en;
      nodes.forEach(function (el) {
        var key = el.getAttribute('data-i18n');
        if (dict[key] === undefined) return;
        if (key.indexOf('body_') === 0) {
          el.innerHTML = dict[key];
        } else {
          el.textContent = dict[key];
        }
      });
      if (btnEn && btnPt) {
        btnEn.classList.toggle('active', lang === 'en');
        btnPt.classList.toggle('active', lang === 'pt');
      }
      document.documentElement.setAttribute('lang', lang);
      saveLang(lang);
    }

    if (btnEn) btnEn.addEventListener('click', function () { applyLang('en'); });
    if (btnPt) btnPt.addEventListener('click', function () { applyLang('pt'); });

    var initial = getSavedLang() || 'en';
    applyLang(initial);

    if (copyBtn) {
      var val = document.getElementById('email-value');
      copyBtn.addEventListener('click', function () {
        var text = val.textContent.trim();
        var lang = document.documentElement.getAttribute('lang') || 'en';
        var dict = DICT[lang] || DICT.en;
        function done() {
          copyBtn.textContent = dict.copy_done;
          copyBtn.classList.add('copied');
          setTimeout(function () {
            copyBtn.textContent = dict.copy_btn;
            copyBtn.classList.remove('copied');
          }, 1600);
        }
        function fallbackSelect() {
          var range = document.createRange();
          range.selectNodeContents(val);
          var sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(fallbackSelect);
        } else {
          fallbackSelect();
        }
      });
    }
  })();
