<style>
  /* Layout concept: a single scroll "scroll of parchment" laid over the app's own dark
     RPG interface — a sticky quest-log header, numbered chapters like quest steps, each
     in a card styled exactly like the app's own BackgroundCard component. */
  :root {
    --bg: #05070F;
    --bg-secondary: #0D1117;
    --card: #161B27;
    --border: #262D3D;
    --primary: #8B5CF6;
    --primary-light: #A78BFA;
    --text: #F5F5F7;
    --text-secondary: #B4B8C5;
    --text-muted: #6B7280;
    --font-display: 'Cinzel', Georgia, 'Times New Roman', serif;
    --font-body: 'Manrope', -apple-system, 'Segoe UI', sans-serif;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    padding-bottom: 48px;
    line-height: 1.6;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0 0 auto;
    height: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: var(--bg-secondary);
  }

  a { color: var(--primary-light); text-decoration: none; }
  a:hover { text-decoration: underline; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--primary-light); outline-offset: 2px; }

  .wrap {
    max-width: 680px;
    margin: 0 auto;
  }

  header.top {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 5;
    background: linear-gradient(to bottom, var(--bg) 80%, transparent);
    padding-top: 16px;
    padding-bottom: 10px;
    margin: 0 -16px;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-muted);
    min-width: 0;
  }

  .crumb .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary);
    flex-shrink: 0;
  }

  .lang-switch {
    flex-shrink: 0;
    display: flex;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
  }

  .lang-switch button {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: .04em;
    border: none;
    background: transparent;
    color: var(--text-muted);
    padding: 5px 11px;
    border-radius: 999px;
    cursor: pointer;
  }

  .lang-switch button.active {
    background: var(--primary);
    color: #0B0414;
  }

  .hero {
    padding: 28px 0 24px;
  }

  .hero .emblem {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--primary), #5B21B6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    margin-bottom: 18px;
    box-shadow: 0 0 0 1px var(--border), 0 8px 24px -8px rgba(139, 92, 246, .55);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 6vw, 38px);
    line-height: 1.15;
    letter-spacing: .01em;
    margin: 0 0 10px;
    text-wrap: balance;
  }

  .hero p.sub {
    color: var(--text-secondary);
    font-size: 15.5px;
    max-width: 50ch;
    margin: 0 0 16px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-secondary);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px 12px;
  }

  nav.toc {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 18px 18px 8px;
    margin-bottom: 28px;
  }

  nav.toc .toc-label {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--primary-light);
    margin: 0 0 10px;
  }

  nav.toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    padding-bottom: 10px;
  }

  @media (min-width: 560px) {
    nav.toc ol { grid-template-columns: 1fr 1fr; }
  }

  nav.toc a {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 13.5px;
    padding: 7px 4px;
    border-radius: 8px;
  }

  nav.toc a:hover { color: var(--text); text-decoration: none; background: rgba(139,92,246,.1); }

  nav.toc a .n {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--primary-light);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    width: 1.4em;
    flex-shrink: 0;
  }

  section.chapter {
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 16px;
    scroll-margin-top: 72px;
  }

  section.chapter .chapter-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  section.chapter .badge {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(139, 92, 246, .14);
    border: 1px solid rgba(139, 92, 246, .3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }

  section.chapter h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    margin: 0;
    letter-spacing: .01em;
  }

  section.chapter .chapter-head .idx {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  section.chapter p, section.chapter li {
    color: var(--text-secondary);
    font-size: 14.5px;
    margin: 0 0 10px;
  }

  section.chapter p:last-child, section.chapter ul:last-child { margin-bottom: 0; }

  section.chapter strong { color: var(--text); font-weight: 600; }

  section.chapter ul {
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 12px 0;
  }

  section.chapter ul li {
    display: flex;
    gap: 10px;
    margin: 0;
    padding-left: 0;
  }

  section.chapter ul li::before {
    content: "";
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--primary);
    flex-shrink: 0;
    margin-top: 7px;
  }

  .callout {
    display: flex;
    gap: 10px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 14px;
    margin-top: 12px;
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .callout .ic { flex-shrink: 0; }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 14px;
  }

  .contact-row .label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .contact-row .value {
    color: var(--text);
    font-size: 14.5px;
    font-weight: 600;
    word-break: break-all;
  }

  .copy-btn {
    flex-shrink: 0;
    background: rgba(139,92,246,.14);
    border: 1px solid rgba(139,92,246,.3);
    color: var(--primary-light);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    padding: 7px 12px;
    border-radius: 8px;
    cursor: pointer;
  }

  .copy-btn:hover { background: rgba(139,92,246,.24); }
  .copy-btn.copied { background: rgba(34,197,94,.18); border-color: rgba(34,197,94,.4); color: #4ADE80; }

  footer.end {
    text-align: center;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 12.5px;
  }

  footer.end .brand {
    font-family: var(--font-display);
    color: var(--text-secondary);
    letter-spacing: .04em;
    margin-bottom: 4px;
